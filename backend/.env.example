PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/splitzy
JWT_SECRET=replace_this_with_a_long_random_string
CLIENT_URL=http://localhost:5173

# ── SMTP / Email Configuration (Required for real email delivery) ────────
