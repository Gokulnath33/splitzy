SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@outlook.com
SMTP_PASS=your_email_password
EMAIL_FROM="Splitzy" <your_email@outlook.com>
